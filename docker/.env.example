# Task Lite configuration (BUILD_SPEC §2 Configuration).
# Copy to docker/.env to override. Every variable is optional; the value shown
# is the default. Unset variables keep their defaults.

# Agent bearer token for /mcp. If unset, one is generated on first boot into
# /data/secrets/agent-token (mode 0600) and shown in Settings. Never logged.
# TASKLITE_TOKEN=

# Listen port inside the container. The published port in compose.yaml stays
# 127.0.0.1:7420; change both together.
# TASKLITE_PORT=7420

# Host header allowlist (DNS-rebinding guard), comma-separated.
# TASKLITE_ALLOWED_HOSTS=127.0.0.1:7420,localhost:7420

# A run counts as live if its session showed signs of life within this window.
# TASKLITE_LIVE_WINDOW=2m

# An open run with no signal for this long is stale.
# TASKLITE_STALE_AFTER=30m

# Lead claim lease, renewed by any signal from the run. Suspended while the run
# is parked.
# TASKLITE_LEASE=60m

# How long a run may stay parked before it shows under Problems. It keeps its
# claim either way.
# TASKLITE_PARK_MAX=24h

# How long a parked run may sit ready to resume before it shows under Problems
# as "Ready to resume".
# TASKLITE_RESUME_UNATTENDED=30m

# How long a resource may stay unreleased after its run ends before it shows as
# an orphaned resource.
# TASKLITE_ORPHAN_AFTER=15m

# Opt-in push install of agent files (Settings > Agent setup): the path inside
# the container of a host folder the owner bind-mounts, for example a code
# folder. Unset means push install is off; the copy-paste install command
# always works. Task Lite writes only skill folders, its manifest and the
# marked Task Lite section of AGENTS.md or CLAUDE.md there, and never deletes
# anything.
# TASKLITE_PUSH_ROOT=/host-code

# The same folder's path on the host, so the UI can show and accept host
# paths. Needs TASKLITE_PUSH_ROOT.
# TASKLITE_PUSH_HOST_PATH=C:/Users/me/code

# How often push installs are checked for agent files edited outside Task Lite
# (also once at startup). At least 1m; 0 or off turns the check off. Installs
# made with the copy-paste command are checked when an agent claims work.
# TASKLITE_DRIFT_CHECK_INTERVAL=15m

# Local time for the nightly backup.
# TASKLITE_BACKUP_AT=03:00

# Days of backups kept, in every location.
# TASKLITE_BACKUP_KEEP=14

# Opt-in extra backup location: the path inside the container of a host folder
# bind-mounted by the owner (see the commented volume in compose.yaml).
# TASKLITE_BACKUP_EXTRA_DIR=/backups-extra

# MCP clients whose tool results are text only (MCP_SPEC §3 Results), by their
# exact clientInfo.name, comma-separated, ignoring case. These clients give the
# model structuredContent instead of the compact text, so they get no
# outputSchema and no structuredContent. "none" gives every client structured
# results. The default is Claude Code's name.
# TASKLITE_TEXT_ONLY_CLIENTS=claude-code

# "sample" loads the sample data into an empty database.
# TASKLITE_SEED=

# Display time zone: the burn-down's days, "today" and the Timeline's Now line use it.
# Set it to yours: a container's own zone is usually UTC, not your machine's.
# Storage is always UTC. The Timeline reports the zone in use.
# TZ=America/Chicago
