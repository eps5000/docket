# Task Lite configuration (BUILD_SPEC §2 Configuration).
# Copy to docker/.env to override. Every variable is optional; the value shown
# is the default. Unset variables keep their defaults.

# Agent bearer token for /mcp. If unset, one is generated on first boot into
# /data/secrets/agent-token (mode 0600) and shown in Settings. Never logged.
# TASKLITE_TOKEN=

# Listen port inside the container. The published port in compose.yaml stays
# 127.0.0.1:7420; change both together.
# TASKLITE_PORT=7420

# Host header allowlist (DNS-rebinding guard), comma-separated.
# TASKLITE_ALLOWED_HOSTS=127.0.0.1:7420,localhost:7420

# A run counts as live if its session showed signs of life within this window.
# TASKLITE_LIVE_WINDOW=2m

# An open run with no signal for this long is stale.
# TASKLITE_STALE_AFTER=30m

# Lead claim lease, renewed by any signal from the run. Suspended while the run
# is parked.
# TASKLITE_LEASE=60m

# How long a run may stay parked before it shows under Problems. It keeps its
# claim either way.
# TASKLITE_PARK_MAX=24h

# How long a parked run may sit ready to resume before it shows under Problems
# as "Ready to resume".
# TASKLITE_RESUME_UNATTENDED=30m

# How long a resource may stay unreleased after its run ends before it shows as
# an orphaned resource.
# TASKLITE_ORPHAN_AFTER=15m

# Local time for the nightly backup.
# TASKLITE_BACKUP_AT=03:00

# Days of backups kept, in every location.
# TASKLITE_BACKUP_KEEP=14

# Opt-in extra backup location: the path inside the container of a host folder
# bind-mounted by the owner (see the commented volume in compose.yaml).
# TASKLITE_BACKUP_EXTRA_DIR=/backups-extra

# "sample" loads the sample data into an empty database.
# TASKLITE_SEED=

# Display time zone (default: the host's). Storage is always UTC.
# TZ=Europe/London
